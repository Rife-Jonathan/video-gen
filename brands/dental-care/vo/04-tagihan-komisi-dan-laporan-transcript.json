{
 "segments": [
  {
   "start": 0.0,
   "end": 4.36,
   "text": "Buat pemilik klinik, pertanyaan yang paling sering muncul di akhir bulan biasanya cema dua."
  },
  {
   "start": 4.82,
   "end": 7.46,
   "text": "Bulan ini masuk berapa dan komisi dokturnya berapa?"
  },
  {
   "start": 8.36,
   "end": 12.42,
   "text": "Masalahnya, kalau tindakan dicatak di satu tempat dan pembayaran di tempat lain,"
  },
  {
   "start": 12.84,
   "end": 15.56,
   "text": "jawabannya baru ketemu setelah menghitung manual berjam-jam."
  },
  {
   "start": 16.54,
   "end": 21.34,
   "text": "Di video ini, saya akan tunjukkan bagian keuangan dan laporan di Dental Care Studio."
  },
  {
   "start": 22.02,
   "end": 23.1,
   "text": "Kita mulai dari invoice."
  },
  {
   "start": 23.62,
   "end": 25.62,
   "text": "Setelah pemeriksaan dan tindakan selesai,"
  },
  {
   "start": 25.86,
   "end": 29.22,
   "text": "tagihan terbentuk dari tindakan dan obat yang tadi dicatat oleh doktor."
  },
  {
   "start": 29.22,
   "end": 31.38,
   "text": "Jadi tidak ada yang diketik dua kali,"
  },
  {
   "start": 31.68,
   "end": 35.56,
   "text": "dan tidak ada tindakan yang lolos dari tagihan hanya karena lupa dicatat ulang."
  },
  {
   "start": 36.94,
   "end": 40.24,
   "text": "Di daftar invoice, setiap tagihan punya nomornya sendiri,"
  },
  {
   "start": 40.76,
   "end": 43.32,
   "text": "nama pasien, tanggal, dan status pembayaran."
  },
  {
   "start": 43.96,
   "end": 45.26,
   "text": "Statusnya bisa difilter,"
  },
  {
   "start": 45.66,
   "end": 48.46,
   "text": "jadi tagihan yang belum lunas bisa dipisahkan dari yang sudah."
  },
  {
   "start": 49.06,
   "end": 52.24,
   "text": "Kalau salah satu invoice dibuka, rinciannya terlihat lengkap."
  },
  {
   "start": 52.7,
   "end": 54.32,
   "text": "Tindakan apa saja yang ditagihkan,"
  },
  {
   "start": 54.72,
   "end": 55.84,
   "text": "obat apa yang diberikan,"
  },
  {
   "start": 56.3,
   "end": 58.86,
   "text": "berapa totalnya, dan pembayarannya sudah masuk berapa."
  },
  {
   "start": 59.22,
   "end": 61.46,
   "text": "Semuanya bisa dibuka kembali kapan saja,"
  },
  {
   "start": 61.76,
   "end": 63.74,
   "text": "tidak hilang setelah transaksinya selesai."
  },
  {
   "start": 65.6,
   "end": 67.96,
   "text": "Sekarang bagian yang biasanya paling merepotkan,"
  },
  {
   "start": 68.32,
   "end": 69.04,
   "text": "komisi doktor."
  },
  {
   "start": 69.7,
   "end": 70.9,
   "text": "Di menu komisi doktor,"
  },
  {
   "start": 71.12,
   "end": 73.74,
   "text": "sistem menghitung komisi dari tindakan yang sudah dikerjakan,"
  },
  {
   "start": 74.02,
   "end": 75.78,
   "text": "lalu menempilkan pendapatan kotor,"
  },
  {
   "start": 76.1,
   "end": 77.7,
   "text": "potongan, dan profit bersihnya."
  },
  {
   "start": 78.74,
   "end": 81.34,
   "text": "Rinciannya bisa dilihat per doktor dan per periode."
  },
  {
   "start": 81.78,
   "end": 84.26,
   "text": "Jadi kalau ada doktor yang menanyakan angkanya dari mana,"
  },
  {
   "start": 84.64,
   "end": 85.72,
   "text": "tinggal buka rinciannya,"
  },
  {
   "start": 86.02,
   "end": 88.36,
   "text": "terlihat invoice mana saja yang menyumbang ke angka itu."
  },
  {
   "start": 89.12,
   "end": 91.98,
   "text": "Ini yang membuat pembagian komisi jadi lebih enak dibicarakan,"
  },
  {
   "start": 92.34,
   "end": 94.4,
   "text": "karena kedua pihak melihat data yang sama."
  },
  {
   "start": 96.66,
   "end": 98.6,
   "text": "Dokter sendiri juga punya halamannya."
  },
  {
   "start": 99.06,
   "end": 100.4,
   "text": "Ketika masuk sebagai doktor,"
  },
  {
   "start": 100.64,
   "end": 102.14,
   "text": "dia bisa melihat komisinya sendiri"
  },
  {
   "start": 102.14,
   "end": 104.32,
   "text": "tanpa perlu meminta rekap ke bagian admin."
  },
  {
   "start": 105.16,
   "end": 106.94,
   "text": "Selain uang, ada juga sisi team."
  },
  {
   "start": 107.54,
   "end": 108.38,
   "text": "Di menu rekap staff,"
  },
  {
   "start": 108.74,
   "end": 111.38,
   "text": "kehadiran dan aktivitas staff terekap dalam satu halaman."
  },
  {
   "start": 112.04,
   "end": 113.9,
   "text": "Dokter, perawat, dan front office"
  },
  {
   "start": 113.9,
   "end": 115.14,
   "text": "punya menunya masing-masing"
  },
  {
   "start": 115.14,
   "end": 117.3,
   "text": "dengan hak akses yang berbeda sesuai perannya."
  },
  {
   "start": 119.22,
   "end": 121.36,
   "text": "Semua angka tadi bermuara di dashboard."
  },
  {
   "start": 121.86,
   "end": 124.14,
   "text": "Di halaman depan terlihat pendapatan bulan berjalan,"
  },
  {
   "start": 124.58,
   "end": 125.72,
   "text": "jumlah anterian aktif,"
  },
  {
   "start": 126.0,
   "end": 126.86,
   "text": "jumlah pasian baru,"
  },
  {
   "start": 127.42,
   "end": 129.04,
   "text": "dan grafik trend pendapatan harian."
  },
  {
   "start": 129.66,
   "end": 131.02,
   "text": "Rentang grafiknya bisa diganti"
  },
  {
   "start": 131.02,
   "end": 134.52,
   "text": "7 hari, 14 hari, atau 30 hari terakhir."
  },
  {
   "start": 135.38,
   "end": 137.16,
   "text": "Di bawahnya masih ada ringkasan lain,"
  },
  {
   "start": 137.5,
   "end": 138.88,
   "text": "seperti demografi pasian"
  },
  {
   "start": 138.88,
   "end": 140.9,
   "text": "dan tindakan yang paling sering dikerjakan."
  },
  {
   "start": 141.5,
   "end": 143.92,
   "text": "Jadi pemilik klinik bisa melihat kondisi kliniknya"
  },
  {
   "start": 143.92,
   "end": 144.88,
   "text": "dalam satu layar"
  },
  {
   "start": 144.88,
   "end": 147.04,
   "text": "tanpa membuka spreadsheet satu per satu."
  },
  {
   "start": 147.88,
   "end": 150.82,
   "text": "Intinya, angka di dashboard itu bukan input terpisah."
  },
  {
   "start": 151.12,
   "end": 153.44,
   "text": "Semuanya berasal dari tindakan yang dicatat dokter"
  },
  {
   "start": 153.44,
   "end": 155.02,
   "text": "dan pembayaran yang dicatat kasir,"
  },
  {
   "start": 155.32,
   "end": 156.66,
   "text": "mengalir sendiri ke atas."
  },
  {
   "start": 157.2,
   "end": 159.82,
   "text": "Kalau ingin melihat langsung laporan dan halaman komisinya,"
  },
  {
   "start": 160.2,
   "end": 162.8,
   "text": "versi demonya bisa dicoba lewat tautan di deskripsi."
  }
