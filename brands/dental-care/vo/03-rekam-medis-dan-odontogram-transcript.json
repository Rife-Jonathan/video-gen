{
 "segments": [
  {
   "start": 0.0,
   "end": 1.92,
   "text": "Rekam medis gigi punya masalah yang khas."
  },
  {
   "start": 2.24,
   "end": 4.54,
   "text": "Catatannya tidak cuma soal kluhan pasien,"
  },
  {
   "start": 4.9,
   "end": 6.82,
   "text": "tapi soal gigi mana yang bermasalah."
  },
  {
   "start": 7.16,
   "end": 10.24,
   "text": "Sudah ditambal di sebelah mana dan mana yang sudah dicabut."
  },
  {
   "start": 10.86,
   "end": 12.46,
   "text": "Kalau semua itu ditulis di kertas,"
  },
  {
   "start": 12.72,
   "end": 15.64,
   "text": "dokter berikutnya harus menebak dari tulisan tangan orang lain."
  },
  {
   "start": 16.16,
   "end": 20.54,
   "text": "Di video ini saya akan tunjukkan bagaimana bagian itu dikerjakan di Dental Care Studio."
  },
  {
   "start": 22.26,
   "end": 24.48,
   "text": "Kita mulai dari halaman pemeriksaan."
  },
  {
   "start": 24.78,
   "end": 26.46,
   "text": "Setelah pasien masuk ruang periksa,"
  },
  {
   "start": 26.46,
   "end": 30.64,
   "text": "dokter membuka data pasien dan mengisi catatan klinis dengan format soap."
  },
  {
   "start": 30.96,
   "end": 33.64,
   "text": "Subjektif untuk kluhan yang disampaikan pasien,"
  },
  {
   "start": 34.0,
   "end": 35.94,
   "text": "objektif untuk temuan pemeriksaan,"
  },
  {
   "start": 36.28,
   "end": 39.42,
   "text": "assessment untuk diagnosis, dan plan untuk rencana perawatan."
  },
  {
   "start": 40.08,
   "end": 42.96,
   "text": "Di bagian diagnosis ada pilihan kode ICD-10."
  },
  {
   "start": 43.44,
   "end": 46.24,
   "text": "Dokter memilih dari daftar, tidak mengetik bebas."
  },
  {
   "start": 46.6,
   "end": 48.96,
   "text": "Jadi istilah yang dipakai seragam antar dokter"
  },
  {
   "start": 48.96,
   "end": 52.5,
   "text": "dan catatannya tetap terbaca ketika dibuka berpulan-pulan kemudian."
  },
  {
   "start": 53.34,
   "end": 55.96,
   "text": "Sekarang bagian yang paling khas untuk klinik gigi."
  },
  {
   "start": 55.96,
   "end": 56.84,
   "text": "Odontogram."
  },
  {
   "start": 57.26,
   "end": 59.34,
   "text": "Ini adalah peta gigi yang bisa diklik."
  },
  {
   "start": 59.7,
   "end": 62.92,
   "text": "Setiap gigi punya nomornya sendiri sesuai penomoran standar"
  },
  {
   "start": 62.92,
   "end": 65.12,
   "text": "dan kondisinya ditandai dengan warna."
  },
  {
   "start": 65.58,
   "end": 68.76,
   "text": "Dokter tinggal memilih giginya, lalu memilih kondisinya."
  },
  {
   "start": 69.12,
   "end": 71.36,
   "text": "Karies, tambalan, gigi hilang,"
  },
  {
   "start": 71.62,
   "end": 74.82,
   "text": "sampai gigi yang sudah dicabut masing-masing punya warna berbeda."
  },
  {
   "start": 75.24,
   "end": 79.2,
   "text": "Karena ditandai dengan warna, kondisi mulut pasien bisa dibaca sekilas"
  },
  {
   "start": 79.2,
   "end": 81.62,
   "text": "tanpa harus membaca satu persatu catatannya."
  },
  {
   "start": 82.36,
   "end": 85.3,
   "text": "Daftar kondisi giginya sendiri bisa diatur di menu tersendiri."
  },
  {
   "start": 85.3,
   "end": 88.94,
   "text": "Jadi kalau klinik punya istilah atau penandaan yang biasa dipakai,"
  },
  {
   "start": 89.36,
   "end": 92.22,
   "text": "daftarnya bisa disesuaikan, bukan di kunci bawaan sistem."
  },
  {
   "start": 93.0,
   "end": 95.64,
   "text": "Setelah pemeriksaan selesai, dokter menentukan tindakan."
  },
  {
   "start": 96.1,
   "end": 99.66,
   "text": "Di menu tindakan sudah tersedia daftar layanan lengkap dengan kodah,"
  },
  {
   "start": 99.88,
   "end": 102.28,
   "text": "kategori, tarif, dan perkiraan durasinya."
  },
  {
   "start": 102.74,
   "end": 105.96,
   "text": "Dokter memilih dari daftar, tidak mengetik ulang nama tindakan."
  },
  {
   "start": 106.4,
   "end": 109.88,
   "text": "Karena tarifnya sudah tersimpan di sana, harga yang keluar konsisten,"
  },
  {
   "start": 110.2,
   "end": 112.42,
   "text": "tidak berubah tergantung siapa yang jaga hari itu."
  },
  {
   "start": 113.18,
   "end": 115.5,
   "text": "Semua yang dicatat tadi menempel ke pasiennya."
  },
  {
   "start": 115.82,
   "end": 118.48,
   "text": "Di halaman detail pasien ada tab priwayat kunjungan"
  },
  {
   "start": 118.48,
   "end": 122.82,
   "text": "yang menampilkan setiap kali pasien datang beserta apa yang dikerjakan waktu itu."
  },
  {
   "start": 123.26,
   "end": 124.84,
   "text": "Ada juga tab priwayat perubahan,"
  },
  {
   "start": 125.24,
   "end": 127.9,
   "text": "jadi terlihat catatan mana yang pernah diubah dan kapan."
  },
  {
   "start": 128.4,
   "end": 130.56,
   "text": "Ini yang membuat penanganan jadi lebih mudah"
  },
  {
   "start": 130.56,
   "end": 132.62,
   "text": "ketika pasien ditangani dokter yang berbeda."
  },
  {
   "start": 133.04,
   "end": 135.32,
   "text": "Dokter yang baru pertama kali menangani pasien itu"
  },
  {
   "start": 135.32,
   "end": 136.8,
   "text": "bisa membuka odontogramnya,"
  },
  {
   "start": 137.18,
   "end": 140.36,
   "text": "melihat gigi mana yang sudah dikerjakan lalu melanjutkan dari sana."
  },
  {
   "start": 141.0,
   "end": 143.4,
   "text": "Jadi ringkasnya, catatan klinis terstruktur,"
  },
  {
   "start": 143.78,
   "end": 145.8,
   "text": "kondisi gigi terpetakan per gigi,"
  },
  {
   "start": 146.02,
   "end": 147.78,
   "text": "dan priwayatnya tersimpan per pasien."
  },
  {
   "start": 148.18,
   "end": 151.48,
   "text": "Tiga hal yang kalau masih dikertas biasanya paling cepat berantakan."
  },
  {
   "start": 152.08,
   "end": 155.1,
   "text": "Kalau ingin melihat langsung odontogram dan halaman pemeriksaannya,"
  },
  {
   "start": 155.48,
   "end": 158.02,
   "text": "versi demonya bisa dicoba lewat tautan di deskripsi."
  }
