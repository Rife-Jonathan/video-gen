{
 "segments": [
  {
   "start": 0.0,
   "end": 8.5,
   "text": "Kalau kamu punya klinik gigi, salah satu hal yang paling sering bikin ribut di meja depan adalah urusan jatwal dan anterian."
  },
  {
   "start": 9.02,
   "end": 15.54,
   "text": "Siapa yang datang duluan, siapa yang sudah janjian, dan siapa yang cuma datang tanpa konfirmasi."
  },
  {
   "start": 16.32,
   "end": 26.86,
   "text": "Di video ini saya akan tunjukkan bagaimana dental care studio menangani bagian itu dari pasien membuat janji sampai namanya dipanggil masuk ruang periksa."
  },
  {
   "start": 27.86,
   "end": 29.82,
   "text": "Kita mulai dari sisi pasien."
  },
  {
   "start": 30.4,
   "end": 33.02,
   "text": "Di website klinik ada formulir reservasi."
  },
  {
   "start": 33.62,
   "end": 40.08,
   "text": "Pasien mengisi nama, memilih dokter, memilih tanggal, dan memilih jam yang masih kosong."
  },
  {
   "start": 40.52,
   "end": 47.42,
   "text": "Slot yang sudah terisi tidak ditampilkan, jadi pasien tidak bisa memilih jam yang sebenarnya sudah penuh."
  },
  {
   "start": 48.04,
   "end": 53.02,
   "text": "Begitu formulir dikirim, jatwalnya masuk ke menu appointment di sisi admin."
  },
  {
   "start": 53.02,
   "end": 57.32,
   "text": "Di sini, seluruh jatwal ditampilkan dalam bentuk kalender."
  },
  {
   "start": 57.9,
   "end": 63.34,
   "text": "Admin bisa berpindah antartanggal dan memfilter tampilan berdasarkan dokter tertentu."
  },
  {
   "start": 63.86,
   "end": 71.6,
   "text": "Jadi kalau ada dua dokter praktik di hari yang sama, jatwal masing-masing bisa dilihat terpisah, tidak menumpuk jadi satu."
  },
  {
   "start": 72.34,
   "end": 77.82,
   "text": "Admin juga bisa menambah appointment langsung dari sini, misalnya untuk pasien yang menalfon."
  },
  {
   "start": 77.82,
   "end": 85.9,
   "text": "Prosesnya sama, pilih pasien, pilih dokter, pilih tanggal dan jam, bedanya cuma siapa yang mengisi."
  },
  {
   "start": 86.7,
   "end": 88.82000000000001,
   "text": "Sekarang kita lanjut ke hari pelaksanaan."
  },
  {
   "start": 89.92,
   "end": 93.06,
   "text": "Pasien datang dan front office membuka menu antrian."
  },
  {
   "start": 93.76,
   "end": 100.08,
   "text": "Di layar ini terlihat siapa yang sedang menunggu, siapa yang sedang diperiksa, dan berapa nomor urutnya."
  },
  {
   "start": 100.74,
   "end": 107.16,
   "text": "Setiap baris punya tombol panggil, jadi front office tinggal menekan tombol itu ketika giliran pasien tiba."
  },
  {
   "start": 107.94,
   "end": 111.04,
   "text": "Statusnya berubah mengikuti kondisi nyata di klinik."
  },
  {
   "start": 111.42,
   "end": 114.34,
   "text": "Menunggu, sedang diperiksa, selesai."
  },
  {
   "start": 114.96,
   "end": 122.96,
   "text": "Karena statusnya terlihat di layar, front office tidak perlu bolak-balik ke ruang praktik hanya untuk memastikan dokternya sudah selesai atau belum."
  },
  {
   "start": 123.68,
   "end": 131.74,
   "text": "Ada juga tep riwayat antrian. Antrian hari kemarin dan hari-hari sebelumnya tetap tersimpan tidak hilang begitu hari berganti."
  },
  {
   "start": 131.74,
   "end": 138.04,
   "text": "Jadi kalau ada pasien yang menanyakan kapan terakhir dia datang, catatannya bisa dibuka lagi."
  },
  {
   "start": 138.88,
   "end": 141.78,
   "text": "Antrian ini juga terhubung dengan data pasien."
  },
  {
   "start": 142.26,
   "end": 146.94,
   "text": "Dari daftar pasien, riwayat kunjungan setiap orang bisa dilihat pertanggal."
  },
  {
   "start": 147.42,
   "end": 152.4,
   "text": "Siapa dokternya, tindakan apa yang dikerjakan, dan kapan kunjungan berikutnya."
  },
  {
   "start": 153.2,
   "end": 157.86,
   "text": "Kalau kita lihat keseluruhannya, tiga hal tadi sebenarnya satu rangkaian."
  },
  {
   "start": 157.86,
   "end": 165.86,
   "text": "Pasien membuat janji dari website, jadualnya muncul di kalender admin, lalu namanya masuk ke antrian di hari kedatangan."
  },
  {
   "start": 166.38,
   "end": 169.08,
   "text": "Tidak ada data yang diketik ulang di antara ketiganya."
  },
  {
   "start": 169.96,
   "end": 176.38,
   "text": "Buat klinik yang sehari melayani belasan sampai puluhan pasien, bagian inilah yang paling terasa bedanya."
  },
  {
   "start": 176.96,
   "end": 180.22,
   "text": "Meja depan tidak lagi mengandalkan buku tulis dan ingatan."
  },
  {
   "start": 180.22,
   "end": 188.48,
   "text": "Kalau kamu ingin mencoba sendiri bagaimana alur ini bekerja, versi demonya bisa diakses lewat tautan di deskripsi."
  }
