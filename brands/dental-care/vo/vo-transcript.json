{
 "segments": [
  {
   "start": 0.0,
   "end": 2.7,
   "text": "Klinik Gigi masih catat rekam medis di kertas."
  },
  {
   "start": 3.24,
   "end": 4.76,
   "text": "Ini Dental Care Studio."
  },
  {
   "start": 5.34,
   "end": 7.34,
   "text": "17 modul, satu aplikasi."
  },
  {
   "start": 7.98,
   "end": 12.08,
   "text": "Dari pendaftaran front office, antrian pasian, sampai invoice."
  },
  {
   "start": 12.72,
   "end": 13.56,
   "text": "Semuanya nyambung."
  },
  {
   "start": 13.96,
   "end": 16.5,
   "text": "Tidak ada lagi buku antrian dan Excel terpisah."
  },
  {
   "start": 16.86,
   "end": 19.94,
   "text": "Yang paling menonjol, odontogram digital interactive."
  },
  {
   "start": 20.44,
   "end": 23.8,
   "text": "Klik giginya, langsung tercatat di rekam medis pasian."
  },
  {
   "start": 24.24,
   "end": 26.86,
   "text": "Riwayat perawatan tersimpan rapi per gigi."
  },
  {
   "start": 27.14,
   "end": 29.08,
   "text": "Komisi dokter di hitung otomatis."
  },
  {
   "start": 29.08,
   "end": 32.68,
   "text": "Rekap kinerja staff, stok farmasi, kode promo."
  },
  {
   "start": 33.22,
   "end": 34.96,
   "text": "Semua ada di dashboard analitik."
  },
  {
   "start": 35.24,
   "end": 37.28,
   "text": "Tidak perlu hitung manual tiap akhir bulan."
  },
  {
   "start": 37.78,
   "end": 41.02,
   "text": "Dan sudah disiapkan untuk terhubung satu sehat kemences."
  },
  {
   "start": 41.58,
   "end": 44.46,
   "text": "Klinik bisa jalan dalam 30 menit setelah dipasang."
  },
  {
   "start": 44.82,
   "end": 48.8,
   "text": "Paket hosted, 1.250.000 untuk sepuluh klinik pertama."
  },
  {
   "start": 49.44,
   "end": 51.68,
   "text": "Coba demonya, tautan di deskripsi."
  }
 ],
